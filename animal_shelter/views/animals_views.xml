<odoo>
    <!-- ACTION Definition -->
    <record id="animals_action" model="ir.actions.act_window">
        <field name="name">Animals</field>
        <field name="res_model">animals</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LIST VIEW -->
    <record id="animals_view_list" model="ir.ui.view">
        <field name="name">animals.list</field>
        <field name="model">animals</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="animal_type_id"/>
                <field name="weight"/>
                <field name="gender"/>
                <field name="birth_date"/>
                
             </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="animals_view_form" model="ir.ui.view">
        <field name="name">animals.form</field>
        <field name="model">animals</field>
        <field name="arch" type="xml">
            <form>
               <header>
                   <button name="at_center" type="object" string="Arrived at Center" invisible="animal_status in ('at_the_shelter','released')" />
                   <button name="release_animal" type="object" string="Release Animal" invisible="animal_status in ('not_received','released')"/>
                   <field name="animal_status" widget="statusbar"/>
               </header>
                <sheet>
                    <h1> <field name="name"/></h1>
                    <group>
                          <field name="picture" widget = "image"
                          style="width:200px; height:200px; object-fit:cover;
                          overflow:hidden"/>
                          <group>
                              <field name="animal_type_id"/>
                              <field name="gender" widget="radio" options="{'horizontal':true}"/>
                              <field name="all_vaccinated"/>
                              <field name="feeding_time" widget="float_time"/>
                              <field name="location_id"/>
                              <field name="sponsor_id"/>
                          </group>   
                    </group>
                    <notebook>
                         <page string="Description">
                            <group>
                                 <field name="description"/>
                                 <field name="birth_date"/>
                                 <filed name="weight"/>
                                 <field name="diet"/>
                                 <field name="arrival_time"/>
                            </group>
                        </page>
                        <page string="Vaccines">
                            <field name="animal_vaccination_ids">
                                <list>
                                    <field name = "vaccine_id"/>
                                    <field name = "status"/>
                                    <button name = "vaccinated_action" type = "object" string ="Vaccinated" invisible = "status == 'vaccinated'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>