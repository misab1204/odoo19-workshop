<odoo>
    <!-- ACTION Definition -->
    <record id="animal_location_action" model="ir.actions.act_window">
        <field name="name">Shelter Locations</field>
        <field name="res_model">animal.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LIST VIEW -->
    <record id="animal_location_view_list" model="ir.ui.view">
        <field name="name">animal.location.list</field>
        <field name="model">animal.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="animal_location_view_form" model="ir.ui.view">
        <field name="name">animal.location.form</field>
        <field name="model">animal.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
