<odoo>
    <record id="animal_location_view_form_maintenance" model="ir.ui.view">
        <field name="name">animal.location.form.maintenance</field>
        <field name="model">animal.location</field>
        <field name="inherit_id" ref="animal_shelter.animal_location_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/h1" position="after">      
                <group>
                    <field name="cleaner_user_id"/>
                </group>
             </xpath>   
        </field>
    </record>
</odoo>
