<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="adaptfit_pos_styles" name="AdaptFit Workshop Styles">
        <link rel="stylesheet" href="/adaptfit_apparel/static/src/css/artisan_chat.css"/>
        <script src="/adaptfit_apparel/static/src/js/artisan_chat.js" defer="defer"></script>
    </template>

    <!-- Left Sidebar: Plain Order List -->
    <template id="artisan_chat_sidebar" name="AdaptFit ArtisanChat Sidebar">
        <aside class="ac-sidebar">
            <header class="ac-topbar">
                <div style="min-width:0;">
                    <div class="ac-topbar-title">Workshop Chats</div>
                    <div class="ac-topbar-sub"><t t-esc="artisan_user.name"/></div>
                </div>
                <a href="/odoo" class="ac-link-btn">ERP</a>
            </header>

            <div class="ac-search-box">
                <input id="ac-order-search"
                       type="text"
                       class="ac-search-input"
                       placeholder="Search order # or garment..."/>
            </div>

            <div id="ac-order-list" class="ac-order-list">
                <t t-if="not order_cards">
                    <div class="ac-empty">No active orders.</div>
                </t>
                <t t-foreach="order_cards or []" t-as="card">
                    <t t-set="o" t-value="card['order']"/>
                    <a t-attf-href="/adaptfit/artisan/#{o.id}"
                       t-attf-class="ac-order-row #{'is-selected' if active_order_id == o.id else ''}"
                       t-attf-data-search="#{o.name} #{card['garment_label']} #{card['state_label']} #{card['preview']}">
                        <div class="ac-row-head">
                            <span class="ac-row-name">#<t t-esc="o.name"/></span>
                            <span class="ac-row-time"><t t-esc="card.get('last_time', '')"/></span>
                        </div>
                        <div class="ac-row-garment">
                            <span><t t-esc="card['garment_label']"/> · <t t-esc="card['state_label']"/></span>
                            <t t-if="o.urgency_level == 'clinical_rush'">
                                <span class="ac-rush-tag">RUSH</span>
                            </t>
                        </div>
                        <div class="ac-row-preview">
                            <t t-esc="card['preview']"/>
                        </div>
                    </a>
                </t>
            </div>
        </aside>
    </template>

    <!-- Chat List View -->
    <template id="artisan_chat_list_template" name="AdaptFit ArtisanChat List">
        <t t-call="web.layout">
            <t t-set="title">Workshop Chats</t>
            <t t-call="adaptfit_apparel.adaptfit_pos_styles"/>

            <div class="ac-app ac-app--list">
                <t t-set="active_order_id" t-value="0"/>
                <t t-call="adaptfit_apparel.artisan_chat_sidebar"/>

                <main class="ac-main">
                    <div class="ac-welcome">
                        <h2>Select an order</h2>
                        <p>Choose an order on the left to view measurements, update the stage, or send a message.</p>
                    </div>
                </main>
            </div>
        </t>
    </template>

    <!-- Chat Detail View -->
    <template id="artisan_chat_detail_template" name="AdaptFit ArtisanChat Detail">
        <t t-call="web.layout">
            <t t-set="title">#<t t-esc="order.name"/> · Workshop Chat</t>
            <t t-call="adaptfit_apparel.adaptfit_pos_styles"/>

            <div class="ac-app ac-app--detail">
                <t t-set="active_order_id" t-value="order.id"/>
                <t t-call="adaptfit_apparel.artisan_chat_sidebar"/>

                <main class="ac-main">
                    <!-- Chat Topbar -->
                    <header class="ac-topbar">
                        <div style="display:flex;align-items:center;gap:10px;min-width:0;">
                            <a href="/adaptfit/artisan" class="ac-link-btn ac-back-btn">← Back</a>
                            <div style="min-width:0;">
                                <div class="ac-topbar-title">
                                    #<t t-esc="order.name"/>
                                    <t t-if="order.urgency_level == 'clinical_rush'">
                                        <span class="ac-rush-tag" style="margin-left:6px;">RUSH</span>
                                    </t>
                                </div>
                                <div class="ac-topbar-sub">
                                    <t t-esc="garment_label"/> · <t t-esc="order.calculated_yardage"/>m <t t-esc="order.fabric_id.name"/>
                                </div>
                            </div>
                        </div>
                        <a t-attf-href="/adaptfit/artisan/#{order.id}" class="ac-link-btn">Refresh</a>
                    </header>

                    <!-- Simple Controls: Stage Dropdown + View Specs -->
                    <div class="ac-controls-bar">
                        <form id="ac-stage-form" t-attf-action="/adaptfit/artisan/#{order.id}/stage" method="post" class="ac-stage-select-wrap">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="ac-stage-select">Stage:</label>
                            <select id="ac-stage-select" name="target_state" class="ac-stage-select">
                                <option value="draft" t-att-selected="'selected' if order.state == 'draft' else None">Intake</option>
                                <option value="pattern" t-att-selected="'selected' if order.state == 'pattern' else None">Cutting</option>
                                <option value="stitching" t-att-selected="'selected' if order.state == 'stitching' else None">Sewing</option>
                                <option value="transit" t-att-selected="'selected' if order.state == 'transit' else None">Ready</option>
                            </select>
                        </form>
                        <button type="button" id="ac-toggle-specs" class="ac-link-btn">View Specs</button>
                    </div>

                    <!-- Collapsible Measurements & Features -->
                    <div id="ac-specs-panel" class="ac-specs-panel is-hidden">
                        <div class="ac-specs-list">
                            <div class="ac-spec-item">Arm L / R<strong><t t-esc="order.order_arm_left"/>" / <t t-esc="order.order_arm_right"/>"</strong></div>
                            <div class="ac-spec-item">Chest / Waist<strong><t t-esc="order.order_chest"/>" / <t t-esc="order.order_waist"/>"</strong></div>
                            <div class="ac-spec-item">Inseam L / R<strong><t t-esc="order.order_inseam_left"/>" / <t t-esc="order.order_inseam_right"/>"</strong></div>
                            <div class="ac-spec-item">Fabric<strong><t t-esc="order.calculated_yardage"/> m</strong></div>
                        </div>
                        <t t-if="order.has_magnetic_placket or order.has_port_access_zip or order.has_flatlock_frictionless or order.has_prosthetic_reinforcement or order.has_high_seated_rise">
                            <div class="ac-spec-features">
                                <strong>Features:</strong>
                                <t t-if="order.has_magnetic_placket"> Magnetic Placket ·</t>
                                <t t-if="order.has_port_access_zip"> 2-Way Port (<t t-esc="port_label"/>) ·</t>
                                <t t-if="order.has_flatlock_frictionless"> Flat-Lock Seams ·</t>
                                <t t-if="order.has_prosthetic_reinforcement"> Socket Shield ·</t>
                                <t t-if="order.has_high_seated_rise"> Seated High-Rise</t>
                            </div>
                        </t>
                    </div>

                    <!-- Chat Messages -->
                    <div id="ac-chat-thread" class="ac-thread">
                        <t t-foreach="chat_messages" t-as="msg">
                            <t t-if="msg.get('is_system', False)">
                                <div class="ac-system-event">
                                    <t t-esc="msg['body']"/> · <t t-esc="msg['time']"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div t-attf-class="ac-msg #{'ac-msg--me' if msg['is_me'] else ''}">
                                    <t t-if="not msg['is_me']">
                                        <div class="ac-msg-author"><t t-esc="msg['author']"/></div>
                                    </t>
                                    <t t-if="msg['body']">
                                        <div class="ac-msg-body"><t t-esc="msg['body']"/></div>
                                    </t>
                                    <t t-foreach="msg['images']" t-as="img">
                                        <img class="ac-msg-img" t-attf-src="/web/image/#{img.id}" alt="Seam photo"/>
                                    </t>
                                    <div class="ac-msg-time"><t t-esc="msg['time']"/></div>
                                </div>
                            </t>
                        </t>
                    </div>

                    <!-- Bottom Message Input -->
                    <div class="ac-composer">
                        <div id="ac-photo-preview" class="ac-photo-preview">
                            <div class="ac-photo-preview-info">
                                <img id="ac-photo-thumb" class="ac-photo-thumb" alt="Selected photo"/>
                                <span id="ac-photo-name" class="ac-photo-name"></span>
                            </div>
                            <button type="button" id="ac-photo-clear" class="ac-photo-clear">Remove</button>
                        </div>

                        <form id="ac-msg-form"
                              t-attf-action="/adaptfit/artisan/#{order.id}/message"
                              method="post"
                              enctype="multipart/form-data"
                              class="ac-composer-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label class="ac-attach-btn">
                                Photo
                                <input id="ac-photo-input" type="file" name="photo" accept="image/*" style="display:none;"/>
                            </label>
                            <input id="ac-msg-input"
                                   type="text"
                                   name="body"
                                   class="ac-msg-input"
                                   placeholder="Type a message..."/>
                            <button id="ac-send-btn" type="submit" class="ac-send-btn">Send</button>
                        </form>
                    </div>
                </main>
            </div>

            <!-- Photo Lightbox -->
            <div id="ac-lightbox" class="ac-lightbox" role="dialog" aria-modal="true">
                <button type="button" id="ac-lightbox-close" class="ac-lightbox-close">Close</button>
                <img id="ac-lightbox-img" alt="Seam photo"/>
            </div>
        </t>
    </template>
</odoo>
