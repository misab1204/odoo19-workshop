<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="adaptfit_pos_styles" name="AdaptFit Workshop Styles">
        <link rel="stylesheet" href="/adaptfit_apparel/static/src/css/artisan_chat.css?v=13"/>
        <script src="/adaptfit_apparel/static/src/js/artisan_chat.js?v=13" defer="defer"></script>
    </template>

    <!-- Leftmost Slim Slate-Teal Navigation Rail -->
    <template id="artisan_chat_rail" name="AdaptFit ArtisanChat Rail">
        <nav class="ac-rail" aria-label="Workshop Navigation">
            <div class="ac-rail-group">
                <a href="/adaptfit/artisan" class="ac-rail-logo" title="AdaptFit Workshop">AF</a>
                <button type="button" class="ac-rail-btn is-active" data-rail-filter="all" title="All Chats">
                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </button>
                <button type="button" class="ac-rail-btn" data-rail-filter="rush" title="Rush Orders">
                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </button>
                <button type="button" class="ac-rail-btn" data-rail-filter="pattern" title="Cutting Queue">
                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <circle cx="6" cy="6" r="3"/>
                        <circle cx="6" cy="18" r="3"/>
                        <line x1="20" y1="4" x2="8.12" y2="15.88"/>
                        <line x1="14.47" y1="14.48" x2="20" y2="20"/>
                        <line x1="8.12" y1="8.12" x2="12" y2="12"/>
                    </svg>
                </button>
                <button type="button" class="ac-rail-btn" data-rail-filter="stitching" title="Sewing Queue">
                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7" rx="1"/>
                        <rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="14" y="14" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/>
                    </svg>
                </button>
                <button type="button" class="ac-rail-btn" data-rail-filter="transit" title="Ready for Transit">
                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                </button>
            </div>
            <div class="ac-rail-group">
                <a href="/odoo" class="ac-rail-btn" title="Open ERP Desk">
                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </a>
            </div>
        </nav>
    </template>

    <!-- Reusable Sidebar Order Row -->
    <template id="artisan_chat_sidebar_row" name="AdaptFit ArtisanChat Sidebar Row">
        <a t-attf-href="/adaptfit/artisan/#{o.id}"
           t-attf-class="ac-order-row #{'is-selected' if active_order_id == o.id else ''}"
           t-att-data-state="o.state"
           t-att-data-urgency="o.urgency_level"
           t-attf-data-search="#{o.name} #{row_garment} #{row_state} #{row_preview}">
            <div t-attf-class="ac-avatar #{'ac-avatar--rush' if o.urgency_level == 'clinical_rush' else ('ac-avatar--urgent' if o.urgency_level == 'urgent' else '')}">
                <t t-esc="(o.name or 'AF')[-3:]"/>
                <t t-if="o.urgency_level == 'clinical_rush'">
                    <span class="ac-avatar-status"></span>
                </t>
            </div>
            <div class="ac-row-body">
                <div class="ac-row-head">
                    <span class="ac-row-name">#<t t-esc="o.name"/> · <t t-esc="row_garment"/></span>
                    <span class="ac-row-time"><t t-esc="row_time"/></span>
                </div>
                <div class="ac-row-sub">
                    <span class="ac-row-preview"><t t-esc="row_preview"/></span>
                    <t t-if="o.urgency_level == 'clinical_rush'">
                        <span class="ac-rush-pill">Rush</span>
                    </t>
                    <t t-else="">
                        <span class="ac-stage-tag"><t t-esc="row_state"/></span>
                    </t>
                </div>
            </div>
        </a>
    </template>

    <!-- Left Chats Panel -->
    <template id="artisan_chat_sidebar" name="AdaptFit ArtisanChat Sidebar">
        <aside class="ac-sidebar">
            <div class="ac-side-head">
                <div class="ac-side-user">
                    <div class="ac-avatar ac-avatar--sm">
                        <t t-esc="(artisan_user.name or 'AR')[:2].upper()"/>
                    </div>
                    <div style="min-width:0;">
                        <div class="ac-side-user-name"><t t-esc="artisan_user.name"/></div>
                        <div class="ac-side-user-role">Workshop Artisan</div>
                    </div>
                </div>
                <a href="/odoo" class="ac-text-btn" style="height:30px;padding:0 10px;">ERP</a>
            </div>

            <div class="ac-side-section">
                <div class="ac-side-label">
                    <span>Chats</span>
                </div>
                <div class="ac-tabs-row">
                    <button type="button" class="ac-tab-btn is-active" data-filter="all">All</button>
                    <button type="button" class="ac-tab-btn" data-filter="rush">Rush</button>
                    <button type="button" class="ac-tab-btn" data-filter="pattern">Cutting</button>
                    <button type="button" class="ac-tab-btn" data-filter="stitching">Sewing</button>
                    <button type="button" class="ac-tab-btn" data-filter="transit">Ready</button>
                </div>
            </div>

            <div class="ac-search-box">
                <div class="ac-search-wrap">
                    <svg class="ac-icon ac-icon-sm ac-search-icon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35"/>
                    </svg>
                    <input id="ac-order-search"
                           type="text"
                           class="ac-search-input"
                           placeholder="Search order # or garment..."/>
                </div>
            </div>

            <div id="ac-order-list" class="ac-order-list">
                <t t-if="order_cards is not None">
                    <t t-if="not order_cards">
                        <div class="ac-empty">No active orders.</div>
                    </t>
                    <t t-foreach="order_cards" t-as="card">
                        <t t-set="o" t-value="card['order']"/>
                        <t t-set="row_garment" t-value="card['garment_label']"/>
                        <t t-set="row_state" t-value="card['state_label']"/>
                        <t t-set="row_preview" t-value="card['preview']"/>
                        <t t-set="row_time" t-value="card.get('last_time', '')"/>
                        <t t-call="adaptfit_apparel.artisan_chat_sidebar_row"/>
                    </t>
                </t>
                <t t-else="">
                    <t t-set="fallback_orders" t-value="request.env['adaptive.order'].search([('state', 'in', ('draft', 'pattern', 'stitching', 'transit'))], order='create_date desc')"/>
                    <t t-if="not fallback_orders">
                        <div class="ac-empty">No active orders.</div>
                    </t>
                    <t t-else="">
                        <t t-set="order_meta" t-value="fallback_orders.fields_get(['garment_type', 'state'])"/>
                        <t t-set="garment_map" t-value="dict(order_meta['garment_type']['selection'])"/>
                        <t t-set="state_map" t-value="dict(order_meta['state']['selection'])"/>
                        <t t-foreach="fallback_orders" t-as="o">
                            <t t-set="row_garment" t-value="garment_map.get(o.garment_type, '')"/>
                            <t t-set="row_state" t-value="state_map.get(o.state, '')"/>
                            <t t-set="row_preview" t-value="row_state"/>
                            <t t-set="row_time" t-value="o.create_date.strftime('%H:%M') if o.create_date else ''"/>
                            <t t-call="adaptfit_apparel.artisan_chat_sidebar_row"/>
                        </t>
                    </t>
                </t>
            </div>
        </aside>
    </template>

    <!-- Chat List View -->
    <template id="artisan_chat_list_template" name="AdaptFit ArtisanChat List">
        <t t-call="web.layout">
            <t t-set="title">Workshop Chats</t>
            <t t-call="adaptfit_apparel.adaptfit_pos_styles"/>

            <div class="ac-app ac-app--list">
                <t t-call="adaptfit_apparel.artisan_chat_rail"/>
                <t t-set="active_order_id" t-value="0"/>
                <t t-call="adaptfit_apparel.artisan_chat_sidebar"/>

                <main class="ac-main">
                    <div class="ac-welcome">
                        <div class="ac-welcome-circle">
                            <svg class="ac-icon" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="width:28px;height:28px;" viewBox="0 0 24 24">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                            </svg>
                        </div>
                        <h2>AdaptFit Workshop Chat</h2>
                        <p>Select an order on the left to review measurements, update tailoring stages, or send voice notes and seam photos.</p>
                    </div>
                </main>
            </div>
        </t>
    </template>

    <!-- Chat Detail View -->
    <template id="artisan_chat_detail_template" name="AdaptFit ArtisanChat Detail">
        <t t-call="web.layout">
            <t t-set="title">#<t t-esc="order.name"/> · Workshop Chat</t>
            <t t-call="adaptfit_apparel.adaptfit_pos_styles"/>

            <div class="ac-app ac-app--detail">
                <t t-call="adaptfit_apparel.artisan_chat_rail"/>
                <t t-set="active_order_id" t-value="order.id"/>
                <t t-call="adaptfit_apparel.artisan_chat_sidebar"/>

                <main class="ac-main">
                    <!-- Center Chat Column -->
                    <div class="ac-chat-column">
                        <!-- Chat Header -->
                        <header class="ac-chat-header">
                            <div class="ac-chat-header-left">
                                <a href="/adaptfit/artisan" class="ac-icon-btn ac-back-btn" title="Back to Chats">
                                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                                    </svg>
                                </a>
                                <div style="min-width:0;">
                                    <div class="ac-chat-title">
                                        <span>#<t t-esc="order.name"/></span>
                                        <t t-if="order.urgency_level == 'clinical_rush'">
                                            <span class="ac-rush-pill">Rush</span>
                                        </t>
                                    </div>
                                    <div class="ac-chat-sub">
                                        <t t-esc="garment_label"/> · <t t-esc="order.calculated_yardage"/>m <t t-esc="order.fabric_id.name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="ac-header-actions">
                                <button type="button" id="ac-toggle-specs" class="ac-text-btn" aria-expanded="true">
                                    <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="12" y1="16" x2="12" y2="12"/>
                                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                                    </svg>
                                    <span>Specs</span>
                                </button>
                                <a t-attf-href="/adaptfit/artisan/#{order.id}" class="ac-icon-btn" title="Refresh">
                                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M23 4v6h-6"/>
                                        <path d="M1 20v-6h6"/>
                                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                                    </svg>
                                </a>
                            </div>
                        </header>

                        <!-- Forward-Only Stage Proceed Bar -->
                        <form id="ac-stage-form"
                              t-attf-action="/adaptfit/artisan/#{order.id}/stage"
                              method="post"
                              class="ac-stage-bar"
                              t-att-data-current-state="order.state"
                              t-attf-data-order-name="##{order.name}">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <span class="ac-stage-label">Stage</span>
                            <div class="ac-stage-track">
                                <button type="submit" name="target_state" value="draft" data-step-state="draft" data-step-label="Intake"
                                        t-attf-class="ac-stage-pill #{'is-active' if order.state == 'draft' else ('is-done' if order.state in ('pattern', 'stitching', 'transit', 'fitting', 'delivered') else 'is-proceed')}"
                                        t-att-disabled="'disabled' if order.state in ('draft', 'pattern', 'stitching', 'transit', 'fitting', 'delivered') else None">
                                    <svg class="ac-stage-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Intake</span>
                                </button>
                                <button type="submit" name="target_state" value="pattern" data-step-state="pattern" data-step-label="Cutting"
                                        t-attf-class="ac-stage-pill #{'is-active' if order.state == 'pattern' else ('is-done' if order.state in ('stitching', 'transit', 'fitting', 'delivered') else ('is-proceed is-next' if order.state == 'draft' else 'is-proceed'))}"
                                        t-att-disabled="'disabled' if order.state in ('pattern', 'stitching', 'transit', 'fitting', 'delivered') else None"
                                        title="Proceed permanently to Cutting">
                                    <svg class="ac-stage-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Cutting</span>
                                    <svg class="ac-stage-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                                </button>
                                <button type="submit" name="target_state" value="stitching" data-step-state="stitching" data-step-label="Sewing"
                                        t-attf-class="ac-stage-pill #{'is-active' if order.state == 'stitching' else ('is-done' if order.state in ('transit', 'fitting', 'delivered') else ('is-proceed is-next' if order.state == 'pattern' else 'is-proceed'))}"
                                        t-att-disabled="'disabled' if order.state in ('stitching', 'transit', 'fitting', 'delivered') else None"
                                        title="Proceed permanently to Sewing">
                                    <svg class="ac-stage-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Sewing</span>
                                    <svg class="ac-stage-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                                </button>
                                <button type="submit" name="target_state" value="transit" data-step-state="transit" data-step-label="Ready"
                                        t-attf-class="ac-stage-pill #{'is-active' if order.state == 'transit' else ('is-done' if order.state in ('fitting', 'delivered') else ('is-proceed is-next' if order.state == 'stitching' else 'is-proceed'))}"
                                        t-att-disabled="'disabled' if order.state in ('transit', 'fitting', 'delivered') else None"
                                        title="Proceed permanently to Ready">
                                    <svg class="ac-stage-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Ready</span>
                                    <svg class="ac-stage-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                                </button>
                            </div>
                        </form>

                        <!-- Chat Thread -->
                        <div id="ac-chat-thread" class="ac-thread">
                            <t t-foreach="chat_messages" t-as="msg">
                                <t t-set="msg_body" t-value="msg.get('body') or ''"/>
                                <t t-set="msg_audios" t-value="msg.get('audios', [])"/>
                                <t t-set="is_sys" t-value="msg.get('is_system', False) or msg_body.startswith('Stage updated to:') or msg_body.startswith('Artisan updated stage to:')"/>
                                <t t-if="is_sys">
                                    <div class="ac-system-event">
                                        <t t-esc="msg_body"/> · <t t-esc="msg['time']"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div t-attf-class="ac-msg-group #{'ac-msg-group--me' if msg['is_me'] else ''}">
                                        <div class="ac-msg">
                                            <t t-if="not msg['is_me']">
                                                <div class="ac-msg-author"><t t-esc="msg['author']"/></div>
                                            </t>
                                            <t t-foreach="msg_audios" t-as="aud">
                                                <div class="ac-voice-player" t-attf-data-audio-src="/web/content/#{aud.id}"></div>
                                            </t>
                                            <t t-if="not msg_audios and msg_body">
                                                <div class="ac-msg-body"><t t-esc="msg_body"/></div>
                                            </t>
                                            <t t-foreach="msg['images']" t-as="img">
                                                <img class="ac-msg-img" t-attf-src="/web/image/#{img.id}" alt="Seam photo"/>
                                            </t>
                                        </div>
                                        <div class="ac-msg-time"><t t-esc="msg['time']"/></div>
                                    </div>
                                </t>
                            </t>
                        </div>

                        <!-- Bottom Composer -->
                        <div class="ac-composer">
                            <div id="ac-rec-error" class="ac-rec-error"></div>

                            <div id="ac-photo-preview" class="ac-photo-preview">
                                <div class="ac-photo-preview-info">
                                    <img id="ac-photo-thumb" class="ac-photo-thumb" alt="Selected photo"/>
                                    <span id="ac-photo-name" class="ac-photo-name"></span>
                                </div>
                                <button type="button" id="ac-photo-clear" class="ac-photo-clear">Remove</button>
                            </div>

                            <div id="ac-rec-bar" class="ac-rec-bar">
                                <div class="ac-rec-status">
                                    <span class="ac-rec-dot"></span>
                                    <span>Recording voice note</span>
                                    <span id="ac-rec-timer" class="ac-rec-timer">0:00</span>
                                </div>
                                <div class="ac-rec-actions">
                                    <button type="button" id="ac-rec-cancel" class="ac-rec-cancel">Cancel</button>
                                    <button type="button" id="ac-rec-send" class="ac-send-btn" title="Send Voice Note">
                                        <span>Send</span>
                                        <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <line x1="22" y1="2" x2="11" y2="13"/>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <form id="ac-msg-form"
                                  t-attf-action="/adaptfit/artisan/#{order.id}/message"
                                  method="post"
                                  enctype="multipart/form-data"
                                  class="ac-composer-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <label class="ac-attach-btn" title="Attach Seam Photo">
                                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                    </svg>
                                    <input id="ac-photo-input" type="file" name="photo" accept="image/*" style="display:none;"/>
                                </label>
                                <input id="ac-msg-input"
                                       type="text"
                                       name="body"
                                       class="ac-msg-input"
                                       placeholder="Type here..."/>
                                <button id="ac-mic-btn" type="button" class="ac-mic-btn" title="Record Voice Note">
                                    <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                        <line x1="12" y1="19" x2="12" y2="23"/>
                                        <line x1="8" y1="23" x2="16" y2="23"/>
                                    </svg>
                                </button>
                                <button id="ac-send-btn" type="submit" class="ac-send-btn" title="Send">
                                    <span>Send</span>
                                    <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <line x1="22" y1="2" x2="11" y2="13"/>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Right Order Profile & Specs Pane -->
                    <aside id="ac-info-pane" class="ac-info-pane">
                        <div class="ac-info-top">
                            <button type="button" id="ac-close-specs" class="ac-icon-btn" title="Close Specs">
                                <svg class="ac-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <line x1="18" y1="6" x2="6" y2="18"/>
                                    <line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </button>
                        </div>

                        <div class="ac-info-scroll">
                            <!-- Order Profile Header -->
                            <div class="ac-info-profile">
                                <div t-attf-class="ac-avatar ac-avatar--lg #{'ac-avatar--rush' if order.urgency_level == 'clinical_rush' else ('ac-avatar--urgent' if order.urgency_level == 'urgent' else '')}">
                                    <t t-esc="(order.name or 'AF')[-3:]"/>
                                </div>
                                <div class="ac-info-order-title">#<t t-esc="order.name"/></div>
                                <div class="ac-info-order-sub"><t t-esc="garment_label"/></div>
                            </div>

                            <!-- 3 Quick Action Circles -->
                            <div class="ac-quick-actions">
                                <button type="button" class="ac-quick-action js-copy-specs" title="Copy Measurements">
                                    <span class="ac-quick-circle">
                                        <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <rect x="9" y="9" width="13" height="13" rx="2"/>
                                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                        </svg>
                                    </span>
                                    <span class="js-copy-label">Copy</span>
                                </button>
                                <button type="button" id="ac-quick-photo" class="ac-quick-action" title="Attach Seam Photo">
                                    <span class="ac-quick-circle">
                                        <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                            <circle cx="12" cy="13" r="4"/>
                                        </svg>
                                    </span>
                                    <span>Photo</span>
                                </button>
                                <a t-attf-href="/odoo/adaptive.order/#{order.id}" class="ac-quick-action" title="Open in ERP">
                                    <span class="ac-quick-circle">
                                        <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                            <polyline points="15 3 21 3 21 9"/>
                                            <line x1="10" y1="14" x2="21" y2="3"/>
                                        </svg>
                                    </span>
                                    <span>ERP</span>
                                </a>
                            </div>

                            <!-- Measurements -->
                            <div>
                                <div class="ac-info-section-title">
                                    <span>Measurements</span>
                                </div>
                                <div id="ac-specs-copy-source" class="ac-spec-rows">
                                    <div class="ac-spec-row">
                                        <span>Left Arm</span>
                                        <strong><t t-esc="order.order_arm_left"/>"</strong>
                                    </div>
                                    <div class="ac-spec-row">
                                        <span>Right Arm</span>
                                        <strong><t t-esc="order.order_arm_right"/>"</strong>
                                    </div>
                                    <div class="ac-spec-row">
                                        <span>Chest</span>
                                        <strong><t t-esc="order.order_chest"/>"</strong>
                                    </div>
                                    <div class="ac-spec-row">
                                        <span>Waist</span>
                                        <strong><t t-esc="order.order_waist"/>"</strong>
                                    </div>
                                    <div class="ac-spec-row">
                                        <span>Inseam L / R</span>
                                        <strong><t t-esc="order.order_inseam_left"/>" / <t t-esc="order.order_inseam_right"/>"</strong>
                                    </div>
                                    <div class="ac-spec-row">
                                        <span>Fabric</span>
                                        <strong><t t-esc="order.calculated_yardage"/> m</strong>
                                    </div>
                                    <t t-if="order.target_date">
                                        <div class="ac-spec-row">
                                            <span>Due Date</span>
                                            <strong><t t-esc="order.target_date"/></strong>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Adaptive Features -->
                            <t t-if="order.has_magnetic_placket or order.has_port_access_zip or order.has_flatlock_frictionless or order.has_prosthetic_reinforcement or order.has_high_seated_rise">
                                <div>
                                    <div class="ac-info-section-title">
                                        <span>Adaptive Features</span>
                                    </div>
                                    <div class="ac-feature-list">
                                        <t t-if="order.has_magnetic_placket">
                                            <div class="ac-feature-item">
                                                <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                                <span>Magnetic Placket</span>
                                            </div>
                                        </t>
                                        <t t-if="order.has_port_access_zip">
                                            <div class="ac-feature-item ac-feature-item--alert">
                                                <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                                <span>2-Way Port (<t t-esc="port_label"/>)</span>
                                            </div>
                                        </t>
                                        <t t-if="order.has_flatlock_frictionless">
                                            <div class="ac-feature-item">
                                                <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                                <span>Flat-Lock Seams</span>
                                            </div>
                                        </t>
                                        <t t-if="order.has_prosthetic_reinforcement">
                                            <div class="ac-feature-item">
                                                <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                                <span>Socket Shield</span>
                                            </div>
                                        </t>
                                        <t t-if="order.has_high_seated_rise">
                                            <div class="ac-feature-item">
                                                <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                                <span>Seated High-Rise</span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>

                            <!-- Shared Media (Photos & Voice Notes in Thread) -->
                            <div>
                                <div class="ac-info-section-title">
                                    <span>Shared Media</span>
                                </div>
                                <div class="ac-shared-list">
                                    <t t-set="has_media" t-value="False"/>
                                    <t t-foreach="chat_messages" t-as="m">
                                        <t t-foreach="m.get('images', [])" t-as="img">
                                            <t t-set="has_media" t-value="True"/>
                                            <button type="button" class="ac-shared-item js-open-image" t-attf-data-img-src="/web/image/#{img.id}">
                                                <span class="ac-shared-icon">
                                                    <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                                        <polyline points="21 15 16 10 5 21"/>
                                                    </svg>
                                                </span>
                                                <span class="ac-shared-name"><t t-esc="img.name or 'Seam Photo'"/></span>
                                            </button>
                                        </t>
                                        <t t-foreach="m.get('audios', [])" t-as="aud">
                                            <t t-set="has_media" t-value="True"/>
                                            <a t-attf-href="/web/content/#{aud.id}" target="_blank" class="ac-shared-item">
                                                <span class="ac-shared-icon">
                                                    <svg class="ac-icon ac-icon-sm" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                                    </svg>
                                                </span>
                                                <span class="ac-shared-name"><t t-esc="aud.name or 'Voice Note'"/></span>
                                            </a>
                                        </t>
                                    </t>
                                    <t t-if="not has_media">
                                        <div style="font-size:12px;color:#475569;">No photos or voice notes yet.</div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </aside>
                </main>
            </div>

            <!-- Stage Proceed Confirmation Modal -->
            <div id="ac-stage-confirm-modal" class="ac-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="ac-confirm-title">
                <div class="ac-modal">
                    <div class="ac-modal-icon">
                        <svg class="ac-icon" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 8 16 12 12 16"/>
                            <line x1="8" y1="12" x2="16" y2="12"/>
                        </svg>
                    </div>
                    <h3 id="ac-confirm-title" class="ac-modal-title">Proceed to Next Stage?</h3>
                    <p id="ac-confirm-body" class="ac-modal-body">Are you sure you want to advance this order?</p>
                    <div class="ac-modal-warn">
                        Permanent change — once confirmed, you cannot go back to an earlier stage.
                    </div>
                    <div class="ac-modal-actions">
                        <button type="button" id="ac-confirm-cancel" class="ac-modal-btn ac-modal-btn--cancel">Cancel</button>
                        <button type="button" id="ac-confirm-proceed" class="ac-modal-btn ac-modal-btn--proceed">Yes, Proceed</button>
                    </div>
                </div>
            </div>

            <!-- Photo Lightbox -->
            <div id="ac-lightbox" class="ac-lightbox" role="dialog" aria-modal="true">
                <button type="button" id="ac-lightbox-close" class="ac-lightbox-close">Close</button>
                <img id="ac-lightbox-img" alt="Seam photo"/>
            </div>
        </t>
    </template>
</odoo>
