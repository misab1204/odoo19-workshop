<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_adaptfit" model="ir.ui.view">
        <field name="name">product.template.form.adaptfit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="AdaptFit Eco-Material" name="adaptfit_eco">
                    <group>
                        <group>
                            <field name="is_sustainable_fabric"/>
                            <field name="fabric_certification" invisible="not is_sustainable_fabric"/>
                        </group>
                        <group invisible="not is_sustainable_fabric">
                            <field name="eco_co2_saved_per_m"/>
                            <field name="eco_water_saved_per_m"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_adaptfit_fabrics" model="ir.actions.act_window">
        <field name="name">Sustainable Fabrics</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_sustainable_fabric', '=', True)]</field>
        <field name="context">{'default_is_sustainable_fabric': True, 'default_type': 'consu'}</field>
    </record>
</odoo>
