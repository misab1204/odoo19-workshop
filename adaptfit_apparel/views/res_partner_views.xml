<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_adaptfit" model="ir.ui.view">
        <field name="name">res.partner.form.adaptfit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_adaptive_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-medkit"
                        invisible="not is_adaptive_patient">
                    <field name="adaptive_order_count" widget="statinfo" string="Adaptive Orders"/>
                </button>
            </div>

            <sheet position="before">
                <header invisible="not is_adaptive_patient">
                    <button name="action_create_adaptive_order"
                            string="+ New Adaptive Order"
                            type="object"
                            class="btn-primary"/>
                </header>
            </sheet>

            <field name="vat" position="after">
                <field name="is_adaptive_patient"/>
                <field name="patient_identifier" invisible="not is_adaptive_patient"/>
            </field>

            <notebook position="inside">
                <page string="Patient Dignity &amp; Clinical Profile" name="adaptfit_profile" invisible="not is_adaptive_patient">
                    <group>
                        <group string="Medical Adaptive Conditions (Confidential)">
                            <field name="condition_amputation"/>
                            <field name="condition_burn_graft"/>
                            <field name="condition_stroke_mobility"/>
                            <field name="condition_medical_port"/>
                            <field name="condition_wheelchair"/>
                            <field name="condition_sensory"/>
                        </group>
                        <group string="Permanent Adaptive Preferences">
                            <field name="pref_magnetic_closures"/>
                            <field name="pref_tagless_only"/>
                            <field name="pref_flatlock_seams"/>
                            <field name="pref_bamboo_lining"/>
                            <field name="medical_notes" placeholder="Confidential clinical instructions (collected once, protected forever)..."/>
                        </group>
                    </group>
                    <group string="Asymmetric Anatomical Specifications (Inches)">
                        <group string="Upper Body">
                            <field name="meas_neck"/>
                            <field name="meas_shoulder"/>
                            <field name="meas_chest"/>
                            <field name="meas_arm_left"/>
                            <field name="meas_arm_right"/>
                            <field name="meas_stump_circ_left"/>
                            <field name="meas_stump_circ_right"/>
                        </group>
                        <group string="Lower Body &amp; Seated Fit">
                            <field name="meas_waist"/>
                            <field name="meas_hip"/>
                            <field name="meas_inseam_left"/>
                            <field name="meas_inseam_right"/>
                            <field name="meas_seated_rise"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_adaptfit_patient_form" model="ir.ui.view">
        <field name="name">res.partner.form.adaptfit.patient</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Patient Dignity Profile">
                <header>
                    <button name="action_create_adaptive_order"
                            string="+ New Adaptive Order"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_adaptive_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-medkit">
                            <field name="adaptive_order_count" widget="statinfo" string="Adaptive Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Patient Full Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="image_1920" widget="image" nolabel="1"
                               style="width:300px; height:300px; object-fit:cover; overflow:hidden"/>
                        <group>
                            <field name="patient_identifier"/>
                            <field name="is_adaptive_patient"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="street" placeholder="Street..."/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Patient Dignity &amp; Clinical Profile" name="adaptfit_profile">
                            <group>
                                <group string="Medical Adaptive Conditions (Confidential)">
                                    <field name="condition_amputation"/>
                                    <field name="condition_burn_graft"/>
                                    <field name="condition_stroke_mobility"/>
                                    <field name="condition_medical_port"/>
                                    <field name="condition_wheelchair"/>
                                    <field name="condition_sensory"/>
                                </group>
                                <group string="Permanent Adaptive Preferences">
                                    <field name="pref_magnetic_closures"/>
                                    <field name="pref_tagless_only"/>
                                    <field name="pref_flatlock_seams"/>
                                    <field name="pref_bamboo_lining"/>
                                    <field name="medical_notes" placeholder="Confidential clinical instructions (collected once, protected forever)..."/>
                                </group>
                            </group>
                            <group string="Asymmetric Anatomical Specifications (Inches)">
                                <group string="Upper Body">
                                    <field name="meas_neck"/>
                                    <field name="meas_shoulder"/>
                                    <field name="meas_chest"/>
                                    <field name="meas_arm_left"/>
                                    <field name="meas_arm_right"/>
                                    <field name="meas_stump_circ_left"/>
                                    <field name="meas_stump_circ_right"/>
                                </group>
                                <group string="Lower Body &amp; Seated Fit">
                                    <field name="meas_waist"/>
                                    <field name="meas_hip"/>
                                    <field name="meas_inseam_left"/>
                                    <field name="meas_inseam_right"/>
                                    <field name="meas_seated_rise"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="internal_notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_adaptfit_patient_list" model="ir.ui.view">
        <field name="name">res.partner.list.adaptfit</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Patient Dignity Profiles">
                <field name="avatar_128" string="" widget="image" options="{'size': [64, 64]}" class="rounded-circle"/>
                <field name="patient_identifier"/>
                <field name="complete_name" string="Patient Name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="adaptive_order_count" string="Orders"/>
            </list>
        </field>
    </record>

    <record id="action_adaptfit_patients" model="ir.actions.act_window">
        <field name="name">Patient Dignity Profiles</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_adaptfit_patient_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_adaptfit_patient_form')})]"/>
        <field name="domain">[('is_adaptive_patient', '=', True)]</field>
        <field name="context">{'default_is_adaptive_patient': True}</field>
    </record>
</odoo>
