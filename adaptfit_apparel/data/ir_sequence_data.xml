<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_adaptive_order" model="ir.sequence">
            <field name="name">Adaptive Order Sequence</field>
            <field name="code">adaptive.order</field>
            <field name="prefix">AD-</field>
            <field name="padding">4</field>
            <field name="number_next">1049</field>
        </record>

        <record id="seq_adaptfit_patient" model="ir.sequence">
            <field name="name">AdaptFit Patient Reference</field>
            <field name="code">adaptfit.patient</field>
            <field name="prefix">PT-</field>
            <field name="padding">4</field>
            <field name="number_next">8042</field>
        </record>

        <record id="seq_adaptive_qa_check" model="ir.sequence">
            <field name="name">Adaptive QA Check</field>
            <field name="code">adaptive.qa.check</field>
            <field name="prefix">QA-</field>
            <field name="padding">4</field>
            <field name="number_next">101</field>
        </record>

        <record id="seq_adaptive_settlement" model="ir.sequence">
            <field name="name">Artisan Settlement Sequence</field>
            <field name="code">adaptive.artisan.settlement</field>
            <field name="prefix">STL-</field>
            <field name="padding">4</field>
            <field name="number_next">201</field>
        </record>

        <record id="seq_adaptfit_batch" model="ir.sequence">
            <field name="name">Clinic Dispatch Batch</field>
            <field name="code">adaptfit.batch</field>
            <field name="prefix">BATCH-</field>
            <field name="padding">3</field>
            <field name="number_next">10</field>
        </record>
    </data>
</odoo>
